# Server-only configuration. Create a dedicated Lavanda Supabase project first.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy anon keys are supported as SUPABASE_ANON_KEY instead, never service_role.
APP_ORIGIN=https://lavanda-bymarty.vercel.app
# Exact additional preview origins, comma-separated; no wildcard origins.
CMS_ALLOWED_ORIGINS=
# Generate at least 32 random characters. Put the identical value into private.cms_secrets.
CMS_ANALYTICS_KEY=
# Vercel supplies NODE_ENV and VERCEL_URL; local development can use http://localhost:4173.
