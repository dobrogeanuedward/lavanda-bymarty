{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "functions": {
    "api/site.mjs": {
      "includeFiles": "dist/**/*.html"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/site?view=home"
    },
    {
      "source": "/blog",
      "destination": "/api/site?view=blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/site?view=article&slug=:slug"
    },
    {
      "source": "/lettura",
      "destination": "/api/site?view=article"
    },
    {
      "source": "/pagina/:slug",
      "destination": "/api/site?view=page&slug=:slug"
    },
    {
      "source": "/progetto",
      "destination": "/api/site?view=page&slug=progetto"
    },
    {
      "source": "/manifesto",
      "destination": "/api/site?view=page&slug=manifesto"
    },
    {
      "source": "/fanzine",
      "destination": "/api/site?view=fanzine"
    }
  ]
}
